{
	"name": "@agent-symlink/cli",
	"version": "1.0.0",
	"description": "Fast and safe cross-platform CLI to create and manage symbolic links between AI agent instructions, skills, and rules.",
	"type": "module",
	"license": "MIT",
	"author": "Wesley Maik",
	"homepage": "https://github.com/WesleyMaik/symlink#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WesleyMaik/symlink.git"
	},
	"bugs": {
		"url": "https://github.com/WesleyMaiksymlink/issues"
	},
	"keywords": [
		"symlink",
		"symbolic-link",
		"ai-agents",
		"agents-md",
		"claude",
		"copilot",
		"cursor",
		"windsurf",
		"cli"
	],
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"symlink": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@clack/prompts": "^0.11.0",
		"commander": "^14.0.3",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.8",
		"@types/node": "^24.0.0",
		"typescript": "^7.0.2",
		"vitest": "^3.0.0"
	}
}
